  "aes": {
    "folder": "aes128",
    "python": {
      "file": "aes128/aes128.py",
      "deps": [],
      "install": "none (Python 3 standard library only)",
      "run": "python3 aes128.py",
      "usage": "python3 aes128.py encrypt|decrypt block key [--format hex|text] [--key-format hex|text] [--padding zero|pkcs7]",
      "sampleInput": {
        "action": "encrypt",
        "format": "hex",
        "block": "3243f6a8885a308d313198a2e0370734",
        "keyFormat": "hex",
        "padding": "zero",
        "key": "2b7e151628aed2a6abf7158809cf4f3c"
      },
      "expectedOutput": "3925841d02dc09fbdc118597196a0b32",
      "notes": [
        {
          "fn": "key_expansion",
          "what": "Expands the 16-byte key into 11 round keys (RotWord, SubWord, Rcon)"
        },
        {
          "fn": "sub_bytes",
          "what": "SubBytes: replaces every byte with its S-box value"
        },
        {
          "fn": "shift_rows",
          "what": "ShiftRows: rotates row r left by r"
        },
        {
          "fn": "mix_columns",
          "what": "MixColumns: multiplies each column by the fixed matrix in GF(2⁸)"
        },
        {
          "fn": "add_round_key",
          "what": "AddRoundKey: XORs the state with the round key"
        },
        {
          "fn": "encrypt_block",
          "what": "Initial AddRoundKey + 10 rounds (no MixColumns in round 10)"
        },
        {
          "fn": "decrypt_block",
          "what": "Inverse cipher with InvShiftRows, InvSubBytes, InvMixColumns"
        },
        {
          "fn": "build_sbox",
          "what": "Builds the S-box from GF(2⁸) inverses and the affine transform"
        }
      ]
    },
    "cpp": {
      "file": "aes128/aes128.cpp",
      "deps": [],
      "install": "g++ with C++17 (standard library only)",
      "run": "g++ -std=c++17 -O2 aes128.cpp -o aes128 && ./aes128",
      "usage": "./aes128 encrypt|decrypt block key [--format hex|text] [--key-format hex|text] [--padding zero|pkcs7]",
      "sampleInput": {
        "action": "encrypt",
        "format": "hex",
        "block": "3243f6a8885a308d313198a2e0370734",
        "keyFormat": "hex",
        "padding": "zero",
        "key": "2b7e151628aed2a6abf7158809cf4f3c"
      },
      "expectedOutput": "3925841d02dc09fbdc118597196a0b32",
      "notes": [
        {
          "fn": "KeyExpansion",
          "what": "Expands the key into 11 round keys"
        },
        {
          "fn": "SubBytes",
          "what": "S-box substitution of every byte"
        },
        {
          "fn": "ShiftRows",
          "what": "Rotates row r left by r"
        },
        {
          "fn": "MixColumns",
          "what": "Column mixing in GF(2⁸)"
        },
        {
          "fn": "AddRoundKey",
          "what": "XOR with the round key"
        },
        {
          "fn": "encryptBlock",
          "what": "Initial AddRoundKey + 10 rounds"
        },
        {
          "fn": "decryptBlock",
          "what": "Inverse cipher"
        },
        {
          "fn": "buildSbox",
          "what": "Builds the S-box from its definition"
        }
      ]
    },
    "pythonLibrary": {
      "file": "aes128/aes128_lib.py",
      "deps": [
        "cryptography"
      ],
      "install": "python3 -m pip install cryptography",
      "run": "python3 aes128_lib.py",
      "sampleInput": {
        "action": "encrypt",
        "format": "hex",
        "block": "3243f6a8885a308d313198a2e0370734",
        "key": "2b7e151628aed2a6abf7158809cf4f3c"
      },
      "expectedOutput": "3925841d02dc09fbdc118597196a0b32",
      "notes": [
        {
          "fn": "run",
          "what": "Library route: AES from the cryptography package; hex block and hex key only (no text input, no padding), one raw block in ECB"
        }
      ],
      "route": "library"
    }
  },

      "usage": "python3 caesar.py encrypt|decrypt \"text\" shift",
      "sampleInput": {
        "action": "encrypt",
        "text": "Attack at dawn",
        "shift": 3
      },
      "expectedOutput": "Dwwdfn dw gdzq",
      "notes": [
        {
          "fn": "shift_char",
          "what": "Shifts one A–Z/a–z letter by k places with wrap-around; other characters unchanged"
        },
        {
          "fn": "shift_text",
          "what": "Applies shift_char to every character"
        },
        {
          "fn": "encrypt",
          "what": "E(x) = (x + k) mod 26"
        },
        {
          "fn": "decrypt",
          "what": "D(x) = (x − k) mod 26"
        }
      ]
    },
